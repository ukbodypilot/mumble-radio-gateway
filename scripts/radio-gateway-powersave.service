[Unit]
Description=Radio Gateway power-save tuning
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes

# CPU frequency governor — schedutil allows idle cores to clock down for
# power saving. Transcriber thread is niced at runtime so BusManager keeps
# scheduling priority during inference.
ExecStart=/bin/bash -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo schedutil > $g; done'

# USB autosuspend for devices that are safe: GPS dongle (u-blox 1546:01a8)
# and unused RTL2838 SDR (0bda:2838). Matches by VID:PID, not path, so a
# port-swap (which renumbers e.g. 1-10 → 2-10) doesn't break the unit.
# All active radio devices (AIOC, KV4P, SDRplay, relay, CAT serial) stay on.
ExecStart=/bin/bash -c '\
  for dev in /sys/bus/usb/devices/*; do \
    vid=$(cat "$dev/idVendor" 2>/dev/null) || continue; \
    pid=$(cat "$dev/idProduct" 2>/dev/null) || continue; \
    case "$vid:$pid" in \
      1546:01a8|0bda:2838) \
        echo auto > "$dev/power/control" 2>/dev/null; \
        echo 2    > "$dev/power/autosuspend_delay_ms" 2>/dev/null; \
        echo "  enabled autosuspend on $(basename $dev) ($vid:$pid)"; \
        ;; \
    esac; \
  done'

[Install]
WantedBy=multi-user.target
